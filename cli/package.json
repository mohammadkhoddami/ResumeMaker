{
  "name": "@mohammadhkhoddami/resume-builder",
  "version": "1.0.0",
  "description": "One-command launcher for the Persian Resume Builder app (React + Vite frontend, FastAPI backend)",
  "type": "module",
  "bin": {
    "resume-builder": "./bin/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepack": "node scripts/prepare-package.js",
    "package": "npm run prepack && npm pack",
    "cli": "node ./bin/cli.js",
    "start": "node ./bin/cli.js start",
    "doctor": "node ./bin/cli.js doctor",
    "build": "node ./bin/cli.js build",
    "dev": "node ./bin/cli.js start"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "app",
    "README.md"
  ],
  "keywords": [
    "resume-builder",
    "cli",
    "cv",
    "persian",
    "resume"
  ],
  "author": "Mohammad Hossein Khoddami",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "chalk": "^5.3.0"
  }
}
